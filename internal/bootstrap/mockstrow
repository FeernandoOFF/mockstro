#!/bin/sh
# Project-local mockstro launcher. Pin cliVersion in .maestro/mockstro.yaml.
set -eu
fail() { echo "mockstrow: $*" >&2; exit 1; }
# Development is explicit; normal invocations always use the project's release pin.
if [ "${1:-}" = --dev ]; then
    shift
    dev_cli=${MOCKSTRO_DEV_CLI:-mockstro-dev}
    command -v "$dev_cli" >/dev/null 2>&1 ||
        fail "development CLI not found: $dev_cli; run 'make install-dev' in the mockstro checkout, or set MOCKSTRO_DEV_CLI to the built executable"
    echo "mockstrow: using development CLI $dev_cli" >&2
    exec "$dev_cli" "$@"
fi
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
config=$root/.maestro/mockstro.yaml
[ -f "$config" ] || fail "missing $config; ask the project maintainer to pin cliVersion"
# Read only the standalone top-level scalar; bootstrapping needs no YAML runtime.
version=$(awk '
    /^cliVersion[[:space:]]*:/ {
        if (++seen > 1) exit 2
        value = $0
        sub(/^cliVersion[[:space:]]*:[[:space:]]*/, "", value)
        sub(/[[:space:]]*#.*/, "", value)
        sub(/[[:space:]]*$/, "", value)
        if (value ~ /^"[^"]*"$/ || value ~ /^\047[^\047]*\047$/)
            value = substr(value, 2, length(value) - 2)
        if (value == "") exit 2
        print value
    }
' "$config") || fail "cliVersion must contain one release tag on a top-level line in $config"
[ -n "$version" ] || fail "missing cliVersion in $config; ask the project maintainer to pin a release"
case "$version" in *[!0-9A-Za-z.-]*|"") fail "pin must contain one release tag" ;; esac
printf '%s\n' "$version" | LC_ALL=C grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$' || fail "pin must be a release tag such as v1.2.3"
case $(uname -s) in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) fail "supported systems: macOS and Linux" ;;
esac
case $(uname -m) in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=amd64 ;;
    *) fail "supported architectures: arm64 and amd64" ;;
esac
sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        fail "install sha256sum or shasum for checksum verification"
    fi
}
cache=${MOCKSTRO_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mockstro}/cli/$version/${os}_${arch}
binary=$cache/mockstro
valid() {
    [ -f "$binary" ] && [ -f "$cache/sha256" ] &&
        [ "$(sha256 "$binary")" = "$(cat "$cache/sha256")" ]
}
if ! valid; then
    command -v curl >/dev/null 2>&1 || fail "install curl to download mockstro"
    mkdir -p "$cache"
    tmp=$(mktemp -d "$cache/.download.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    asset=mockstro_${version}_${os}_${arch}
    url=https://github.com/FeernandoOFF/mockstro/releases/download/$version
    echo "mockstrow: downloading $version ($os/$arch)" >&2
    fetch() {
        curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
            --connect-timeout 15 --max-time 300 --output "$tmp/$1" "$url/$1" ||
            fail "download failed; check connectivity and that release $version has $1"
    }
    fetch checksums.txt
    expected=$(awk -v asset="$asset" '$2 == asset {print $1}' "$tmp/checksums.txt")
    printf '%s\n' "$expected" | LC_ALL=C grep -Eq '^[a-fA-F0-9]{64}$' || fail "missing or invalid checksum for $asset"
    fetch "$asset"
    [ "$(sha256 "$tmp/$asset")" = "$expected" ] || fail "checksum mismatch for $asset; nothing installed"
    printf '%s\n' "$expected" > "$tmp/sha256"
    chmod 755 "$tmp/$asset"
    # Same-filesystem renames: concurrent launchers can only publish verified files.
    mv -f "$tmp/sha256" "$cache/sha256"
    mv -f "$tmp/$asset" "$binary"
    rm -rf "$tmp"
    trap - EXIT INT TERM HUP
fi
exec "$binary" "$@"
